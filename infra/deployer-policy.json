{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTheStack",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:ap-southeast-1:826113468815:stack/auth-gate-*/*",
        "arn:aws:cloudformation:ap-southeast-1:826113468815:stack/aws-sam-cli-managed-default/*",
        "arn:aws:cloudformation:ap-southeast-1:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "ReadTemplates",
      "Effect": "Allow",
      "Action": ["cloudformation:ValidateTemplate", "cloudformation:GetTemplateSummary"],
      "Resource": "*"
    },
    {
      "Sid": "SamArtifactBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*",
        "arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*/*"
      ]
    },
    {
      "Sid": "ManageTheFunctions",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:ap-southeast-1:826113468815:function:auth-gate-*"
    },
    {
      "Sid": "ManageTheExecutionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::826113468815:role/auth-gate-*"
    },
    {
      "Sid": "PassRolesToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::826113468815:role/auth-gate-*",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } }
    },
    {
      "Sid": "ManageTheTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:826113468815:table/auth-gate-*"
    },
    {
      "Sid": "CreateTheSigningKey",
      "Effect": "Allow",
      "Action": ["kms:CreateKey", "kms:DescribeKey", "kms:TagResource", "kms:ListAliases"],
      "Resource": "*"
    },
    {
      "Sid": "ManageTheSigningKey",
      "Effect": "Allow",
      "Action": [
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:UpdateKeyDescription",
        "kms:EnableKey",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "kms:UntagResource",
        "kms:ListResourceTags",
        "kms:GetPublicKey",
        "kms:DeleteAlias",
        "kms:UpdateAlias"
      ],
      "Resource": "arn:aws:kms:ap-southeast-1:826113468815:key/*",
      "Condition": { "ForAnyValue:StringLike": { "kms:ResourceAliases": "alias/auth-gate-*" } }
    },
    {
      "Sid": "AliasTheSigningKey",
      "Effect": "Allow",
      "Action": ["kms:CreateAlias", "kms:DeleteAlias", "kms:UpdateAlias"],
      "Resource": [
        "arn:aws:kms:ap-southeast-1:826113468815:alias/auth-gate-*",
        "arn:aws:kms:ap-southeast-1:826113468815:key/*"
      ]
    },
    {
      "Sid": "ManageTheDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateDistributionWithTags",
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:ListTagsForResource",
        "cloudfront:CreateCachePolicy",
        "cloudfront:GetCachePolicy",
        "cloudfront:UpdateCachePolicy",
        "cloudfront:DeleteCachePolicy",
        "cloudfront:ListCachePolicies",
        "cloudfront:GetOriginRequestPolicy",
        "cloudfront:ListOriginRequestPolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageTheParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-1:826113468815:parameter/credo/auth-gate/*"
    },
    {
      "Sid": "OptionalCustomDomain",
      "Effect": "Allow",
      "Action": [
        "acm:RequestCertificate",
        "acm:DescribeCertificate",
        "acm:ListCertificates",
        "route53:ChangeResourceRecordSets",
        "route53:GetChange",
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Diagnostics",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups", "logs:FilterLogEvents", "logs:GetLogEvents"],
      "Resource": "*"
    }
  ]
}
